DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legendary_events?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/legendary_events?schema=public"
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Attached automatically on Vercel when you connect a Blob store.
# Local: run `npx vercel env pull` (uses BLOB_STORE_ID + a short-lived VERCEL_OIDC_TOKEN).
# If those are unset, uploads go to ./uploads-private instead.
BLOB_STORE_ID=""
